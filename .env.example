GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Pinned models (checked with python -m pipeline.smoke_test)
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
KEYFRAME_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Used by the smoke test only (FLUX.1 schnell rejects seeds on Workers AI)
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Experiment switch: on = send the storyboard voice style as "Say <style>: <line>"
TTS_STYLE=off
