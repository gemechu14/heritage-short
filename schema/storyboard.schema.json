{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short storyboard",
  "type": "object",
  "required": ["title", "logline", "audience", "intent", "language", "subtitle_language", "voice", "style_block", "characters", "music", "shots"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "logline": { "type": "string", "minLength": 10 },
    "audience": { "type": "string", "minLength": 10 },
    "intent": { "type": "string", "minLength": 10 },
    "language": { "$ref": "#/$defs/language" },
    "subtitle_language": { "$ref": "#/$defs/language" },
    "voice": {
      "type": "object",
      "required": ["name", "style"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "style": { "type": "string" }
      }
    },
    "style_block": { "type": "string", "minLength": 10 },
    "characters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": { "description": { "type": "string", "minLength": 10 } }
      }
    },
    "music": {
      "type": "object",
      "required": ["cues"],
      "additionalProperties": false,
      "properties": {
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "start_s", "end_s", "description"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^m[0-9]+$" },
              "start_s": { "type": "number", "minimum": 0 },
              "end_s": { "type": "number", "exclusiveMinimum": 0 },
              "description": { "type": "string", "minLength": 5 }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/shot" }
    }
  },
  "$defs": {
    "language": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 2 },
        "name": { "type": "string", "minLength": 2 }
      }
    },
    "shot": {
      "type": "object",
      "required": ["id", "duration_s", "shot_size", "reason", "characters", "image_prompt", "motion", "motion_prompt", "narration_en", "narration", "seed"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]{2}$" },
        "duration_s": { "type": "number", "minimum": 3, "maximum": 12 },
        "shot_size": { "enum": ["extreme_wide", "wide", "medium", "medium_close_up", "close_up", "extreme_close_up", "insert"] },
        "reason": { "type": "string", "minLength": 5 },
        "characters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "image_prompt": { "type": "string", "minLength": 10 },
        "motion": {
          "type": "object",
          "required": ["type", "direction"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["kenburns", "wan", "static"] },
            "direction": { "enum": ["in", "out", "left", "right", "none"] }
          }
        },
        "motion_prompt": { "type": "string" },
        "narration_en": { "type": "string", "minLength": 1 },
        "narration": { "type": "string" },
        "seed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
